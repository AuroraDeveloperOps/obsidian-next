generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Session tracking
model Session {
  id        String   @id @default(cuid())
  workspace String
  mode      String   @default("safe")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  changes   FileChange[]
  tasks     Task[]

  @@index([workspace])
}

// File change history for undo
model FileChange {
  id        String   @id @default(cuid())
  sessionId String
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  filePath    String
  operation   String   // create, edit, delete
  beforeContent String? @db.Text
  afterContent  String? @db.Text

  undone    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([sessionId, createdAt])
  @@index([filePath])
}

// Task history
model Task {
  id        String   @id @default(cuid())
  sessionId String
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  title     String
  status    String   @default("pending") // pending, in_progress, done
  subtasks  Json     @default("[]")
  context   Json     @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sessionId])
}

// Usage tracking
model UsageRecord {
  id        String   @id @default(cuid())
  model     String
  inputTokens  Int
  outputTokens Int
  cost      Float
  createdAt DateTime @default(now())

  @@index([createdAt])
}
